# ─────────────────────────────────────────────────────────────
#  VBT training project — root .gitignore
#  Goal: keep source + small artifacts; exclude venvs, datasets,
#  raw/processed videos, and anything regenerable from the .pt weights.
# ─────────────────────────────────────────────────────────────

# ── Python environments (huge, machine-specific) ──
venv/
.venv/
mobile/.venv-export/
**/__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Data (NEVER committed) — datasets, captured media, annotations,
#    tracking outputs, and the runtime plate_config.json all live here and
#    are local-only. The whole folder is excluded from git. ──
data/
webapp/_uploads/
webapp/static/uploads/
*.mp4
*.mov
*.avi
*.mkv

# ── Reference papers (local-only, not part of the source) ──
papers/

# ── Models: keep the .pt weights + the app's bundled tflite,
#    drop everything that's regenerated by the export script ──
models/*.onnx
models/plate_best_saved_model/
*.engine

# ── Mobile app (deprecated, removed from the repo) ──
mobile/

# ── Node (any other JS tooling) ──
node_modules/

# ── Editor / OS cruft ──
.DS_Store
*.swp
*.orig
.idea/
.vscode/
*.log

# ── Secrets / local env ──
.env
.env*.local
*.pem
*.key
*.p8
*.p12
*.keystore
*.jks
.aider*
