# ─────────────────────────────────────────────────────────────
#  VBT training project — root .gitignore
#  Goal: keep source + small artifacts; exclude venvs, datasets,
#  raw/processed videos, and anything regenerable from the .pt weights.
# ─────────────────────────────────────────────────────────────

# ── Python environments (huge, machine-specific) ──
venv/
.venv/
mobile/.venv-export/
**/__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Datasets & captured media (heavy, not source) ──
data/datasets/
data/processed/
data/tracked/
data/archive/
data/raw/
webapp/_uploads/
webapp/static/uploads/
*.mp4
*.mov
*.avi
*.mkv
# …but keep the small, valuable label exports + config:
!data/annotations/
!data/annotations/**
!data/plate_config.json

# ── Models: keep the .pt weights + the app's bundled tflite,
#    drop everything that's regenerated by the export script ──
models/*.onnx
models/plate_best_saved_model/
*.engine

# ── Mobile app (Expo / React Native) ──
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/ios/
mobile/android/
mobile/expo-env.d.ts
mobile/*.tsbuildinfo
mobile/.metro-health-check*

# ── Node (any other JS tooling) ──
node_modules/

# ── Editor / OS cruft ──
.DS_Store
*.swp
*.orig
.idea/
.vscode/
*.log

# ── Secrets / local env ──
.env
.env*.local
*.pem
*.key
*.p8
*.p12
*.keystore
*.jks
